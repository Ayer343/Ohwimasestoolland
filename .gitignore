*.bak
*.bak2
*.bak3
*.bak4
*.bak-*
*.orig

# ============================================
# BUILD ARTIFACTS / ARCHIVES
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.pem
*.p12
*.pfx
*.key
"@ | Set-Content .gitignore